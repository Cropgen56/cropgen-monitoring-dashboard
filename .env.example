# Optional — override default API hosts (see src/config/endpoints.js)
# VITE_API_BASE_URL=https://your-server.example/v1/api
# VITE_LOCATION_API_ORIGIN=https://your-location.example
# VITE_VILLAGE_BOUNDARY_API_ORIGIN=https://your-village-boundary.example
# VITE_FIELD_DELINEATION_API_ORIGIN=https://your-boundary-delineation.example
# VITE_CROP_CLASSIFICATION_API_ORIGIN=https://your-crop-classification.example
# VITE_CROP_MONITORING_API_BASE_URL=https://your-server.example/v4/api
# Browser-safe API key only; VITE_ values are included in the frontend bundle.
# VITE_CROP_MONITORING_API_KEY=

# Google Maps Platform key with Places API (New) enabled — put the real value in .env.local
#VITE_GOOGLE_MAPS_API_KEY=
# Max km² per detection run (default 2 for the Cloud Run CPU deployment; ~100 for a local GPU backend)
# VITE_DELINEATION_MAX_AREA_KM2=2
